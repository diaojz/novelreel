# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore，不会入库）

# 火山引擎豆包（OpenAI 兼容接口）
# 控制台获取 API Key：https://console.volcengine.com/ark
NOVELREEL_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
NOVELREEL_LLM_API_KEY=在此填入你的火山引擎-API-KEY
NOVELREEL_LLM_MODEL=doubao-seed-1-6-251015

# ---- P1/P2 图片 / 视频生成（同一个火山引擎账号）----
# 不填则自动降级为占位图/占位视频，整条流水线仍能跑通看效果
# NOVELREEL_MEDIA_API_KEY=  # 留空则复用上面的 LLM_API_KEY
NOVELREEL_IMAGE_MODEL=doubao-seedream-4-0-250828
NOVELREEL_VIDEO_MODEL=doubao-seedance-1-0-pro-250528
